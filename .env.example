# GEMINI_API_KEY: Required for Gemini AI API calls (/api/gemini/* and /api/live).
# Copy this file to ".env" for local runs, or configure via Secrets in hosted environments.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Server HTTP/WebSocket listening port (defaults to 3000).
PORT="3000"

# NODE_ENV: Set to "production" when serving the compiled dist/ build, or run "npm start".
# NODE_ENV="production"

# APP_URL: Public URL where this application is hosted (used for callbacks/links if configured).
APP_URL="http://localhost:3000"
